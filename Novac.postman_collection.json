{
  "info": {
    "name": "Novac Project Management System",
    "description": "Role-aware project, team, task submission, and review workflow. Set each account password and copy IDs returned by setup requests into the collection variables before running dependent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5025" },
    { "key": "adminEmail", "value": "admin@nova.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "managerEmail", "value": "" },
    { "key": "managerPassword", "value": "" },
    { "key": "teamLeadEmail", "value": "" },
    { "key": "teamLeadPassword", "value": "" },
    { "key": "employeeEmail", "value": "" },
    { "key": "employeePassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "teamLeadToken", "value": "" },
    { "key": "employeeToken", "value": "" },
    { "key": "managerId", "value": "" },
    { "key": "teamLeadId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Manager login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('managerToken', pm.response.json().token);", "pm.collectionVariables.set('managerId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Team Leader login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('teamLeadToken', pm.response.json().token);", "pm.collectionVariables.set('teamLeadId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{teamLeadEmail}}\",\n  \"password\": \"{{teamLeadPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Employee login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('employeeToken', pm.response.json().token);", "pm.collectionVariables.set('employeeId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Setup (Admin then Manager)",
      "item": [
        {
          "name": "Create Project Manager",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Manager created', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('managerId', pm.response.json().id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Sneha Reddy\",\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\",\n  \"role\": 2,\n  \"designation\": \"Project Manager\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create Employee",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee created', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('employeeId', pm.response.json().id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Asha Nair\",\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\",\n  \"role\": 3,\n  \"designation\": \"QA Analyst\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create Team Leader",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Account created', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('teamLeadId', pm.response.json().id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Sanjay Kumar\",\n  \"email\": \"{{teamLeadEmail}}\",\n  \"password\": \"{{teamLeadPassword}}\",\n  \"role\": 4,\n  \"designation\": \"Technical Team Leader\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create project",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Project created', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('projectId', pm.response.json().id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Team Workflow Project\",\n  \"description\": \"Project for validating the team workflow.\",\n  \"startDate\": \"2026-11-26T00:00:00Z\",\n  \"endDate\": \"2027-01-30T00:00:00Z\",\n  \"status\": 1,\n  \"managerId\": {{managerId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "Add employee to project",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee added', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userIds\": [{{employeeId}}]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members/bulk"
          }
        },
        {
          "name": "Create team and assign lead",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Team created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('teamId', pm.response.json().id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Team Alpha\",\n  \"teamLeadId\": {{teamLeadId}},\n  \"employeeIds\": [{{employeeId}}]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/teams"
          }
        }
      ]
    },
    {
      "name": "Workflow (Team Leader, Employee, Team Leader)",
      "item": [
        {
          "name": "Team Leader dashboard",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teamLeadToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/team-lead"
          }
        },
        {
          "name": "Team Leader creates assigned task",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Task created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('taskId', pm.response.json().id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teamLeadToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Review the checkout workflow\",\n  \"description\": \"Validate checkout and document edge cases.\",\n  \"assignedToId\": {{employeeId}},\n  \"dueDate\": \"2026-12-10T00:00:00Z\",\n  \"priority\": 3\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks"
          }
        },
        {
          "name": "Employee starts task",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": 2 }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}/status"
          }
        },
        {
          "name": "Employee submits for review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": 4 }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}/status"
          }
        },
        {
          "name": "Employee cannot approve task (expect 403)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee review is forbidden', () => pm.response.to.have.status(403));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"approve\": true }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}/review"
          }
        },
        {
          "name": "Team Leader returns task for changes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teamLeadToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"approve\": false }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}/review"
          }
        },
        {
          "name": "Employee resubmits after corrections",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": 4 }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}/status"
          }
        },
        {
          "name": "Team Leader approves task",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{teamLeadToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"approve\": true }", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}/review"
          }
        }
      ]
    }
  ]
}
